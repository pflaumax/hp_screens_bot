BLUESKY_USERNAME=hpscreengrab.bsky.social
BLUESKY_PASSWORD=xxxx-xxxx-xxxx-xxxx
SCREENSHOTS_DIR=/mnt/hp_screenshots
INTERVAL_MINUTES=30

# Potter DB facts placed above the film title
FACTS_ENABLED=true
MAX_FACT_LENGTH=180

# Frame quality: skip broken/near-black frames, prefer frames with a face
FRAME_QUALITY_ENABLED=true
FRAME_CANDIDATES=3

LOG_LEVEL=INFO
